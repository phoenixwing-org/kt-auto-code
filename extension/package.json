{
  "name": "kt-auto-code",
  "displayName": "KT Auto Code",
  "description": "CAA / MSVC C++ 工具：编码修正、Ignore、搜索替换、成员排序与 Codegen 参数表",
  "author": "上海锟钛",
  "version": "0.5.0",
  "license": "Apache-2.0",
  "publisher": "kuntai",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://gitee.com/PhoenixWing321/kt-auto-code.git"
  },
  "homepage": "https://gitee.com/PhoenixWing321/kt-auto-code",
  "bugs": {
    "url": "https://gitee.com/PhoenixWing321/kt-auto-code/issues"
  },
  "keywords": [
    "CAA",
    "CATIA",
    "MSVC",
    "C++",
    "encoding",
    "refactor",
    "search replace",
    "member sort",
    "code generation"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other", "Programming Languages", "Formatters"],
  "galleryBanner": {
    "color": "#1F4E79",
    "theme": "dark"
  },
  "activationEvents": ["onView:ktAutoCode.sidebar"],
  "main": "./dist/extension.js",
  "icon": "media/cn.kt.doc.AutoCode.Color.128.png",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "kt-auto-code",
          "title": "KT Auto Code",
          "icon": "media/kt-auto-code.svg"
        }
      ]
    },
    "views": {
      "kt-auto-code": [
        {
          "type": "webview",
          "id": "ktAutoCode.sidebar",
          "name": "工具栏",
          "initialSize": 1
        },
        {
          "type": "webview",
          "id": "ktAutoCode.modulePanel",
          "name": "工具界面",
          "when": "ktAutoCode.modulePanelVisible",
          "visibility": "visible",
          "initialSize": 12
        }
      ]
    },
    "commands": [
      {
        "command": "ktAutoCode.headerAscii.scan",
        "title": "头文件 ASCII 修正：扫描",
        "icon": "$(search)"
      },
      {
        "command": "ktAutoCode.headerAscii.fix",
        "title": "头文件 ASCII 修正：修复",
        "icon": "$(wrench)"
      },
      {
        "command": "ktAutoCode.settings.headerAscii",
        "title": "KT Auto Code：打开 ASCII 修正设置",
        "icon": "$(settings-gear)"
      },
      {
        "command": "ktAutoCode.settings.scope",
        "title": "KT Auto Code：打开扫描范围设置",
        "icon": "$(settings-gear)"
      },
      {
        "command": "ktAutoCode.encodingFix.scan",
        "title": "编码修正：预检",
        "icon": "$(search)"
      },
      {
        "command": "ktAutoCode.encodingFix.convert",
        "title": "编码修正：转换",
        "icon": "$(file-code)"
      },
      {
        "command": "ktAutoCode.ignore.open",
        "title": "KT Auto Code：打开忽略设置",
        "icon": "$(exclude)"
      },
      {
        "command": "ktAutoCode.ignore.sync",
        "title": "KT Auto Code：从 .gitignore 同步",
        "icon": "$(sync)"
      },
      {
        "command": "ktAutoCode.ignore.analyze",
        "title": "KT Auto Code：分析 Ignore 推荐",
        "icon": "$(search)"
      },
      {
        "command": "ktAutoCode.ignore.openAdvanced",
        "title": "KT Auto Code：打开高级 Ignore 配置",
        "icon": "$(settings-gear)"
      },
      {
        "command": "ktAutoCode.searchReplace.open",
        "title": "KT Auto Code：搜索替换",
        "icon": "$(replace-all)"
      },
      {
        "command": "ktAutoCode.codeRename.configure",
        "title": "KT Auto Code：打开搜索替换 Block",
        "icon": "$(replace-all)"
      },
      {
        "command": "ktAutoCode.codeRename.openAdvanced",
        "title": "KT Auto Code：打开高级搜索替换配置",
        "icon": "$(settings-gear)"
      },
      {
        "command": "ktAutoCode.codegen.open",
        "title": "KT Auto Code：打开 Codegen JSON",
        "icon": "$(table)"
      },
      {
        "command": "ktAutoCode.codegen.importCsv",
        "title": "KT Auto Code：导入 Codegen CSV",
        "icon": "$(file-symlink-file)"
      },
      {
        "command": "ktAutoCode.searchReplace.preview",
        "title": "KT Auto Code：搜索替换预览",
        "icon": "$(search)"
      },
      {
        "command": "ktAutoCode.reorderMembers.preview",
        "title": "KT Auto Code：C++ 成员排序预览",
        "icon": "$(list-ordered)"
      },
      {
        "command": "ktAutoCode.reorderMembers.showResults",
        "title": "KT Auto Code：显示成员排序 Block",
        "icon": "$(list-tree)"
      },
      {
        "command": "ktAutoCode.reorderMembers.closeResults",
        "title": "关闭成员排序 Block",
        "icon": "$(close)"
      },
      {
        "command": "ktAutoCode.uuidReplace.scan",
        "title": "KT Auto Code：扫描 UUID",
        "icon": "$(search)"
      },
      {
        "command": "ktAutoCode.uuidReplace.apply",
        "title": "KT Auto Code：应用 UUID 替换",
        "icon": "$(replace-all)"
      },
      {
        "command": "ktAutoCode.caaDialog.scan",
        "title": "KT Auto Code：扫描 CAA 对话框",
        "icon": "$(search)"
      },
      {
        "command": "ktAutoCode.caaDialog.selectFiles",
        "title": "KT Auto Code：显示 CAA 对话框列表",
        "icon": "$(list-tree)"
      },
      {
        "command": "ktAutoCode.caa.openSettings",
        "title": "KT Auto Code：打开设置",
        "icon": "$(settings-gear)"
      },
      {
        "command": "ktAutoCode.environment.open",
        "title": "KT Auto Code：检查工程环境",
        "icon": "$(settings-gear)"
      },
      {
        "command": "ktAutoCode.sidebar.toggleStyle",
        "title": "KT Auto Code：切换 Ribbon / 小图标",
        "icon": "$(layout)"
      },
      {
        "command": "ktAutoCode.module.code.show",
        "title": "☐ Code"
      },
      {
        "command": "ktAutoCode.module.code.hide",
        "title": "☑ Code"
      },
      {
        "command": "ktAutoCode.worksets.open",
        "title": "KT Auto Code：打开工作集配置",
        "icon": "$(project)"
      },
      {
        "command": "ktAutoCode.modulePanel.close",
        "title": "关闭当前工具界面",
        "icon": "$(close)"
      },
      {
        "command": "ktAutoCode.reorderMembers.addToWorkset",
        "title": "将成员排序结果加入工作集",
        "icon": "$(add)"
      },
      {
        "command": "ktAutoCode.uuidReplace.addToWorkset",
        "title": "将 UUID 结果加入工作集",
        "icon": "$(add)"
      },
      {
        "command": "ktAutoCode.caaDialog.addToWorkset",
        "title": "将 CAA 对话框结果加入工作集",
        "icon": "$(add)"
      },
      {
        "command": "ktAutoCode.codeRename.addToWorkset",
        "title": "将搜索替换结果加入工作集",
        "icon": "$(add)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "ktAutoCode.module.code.show",
          "when": "view == ktAutoCode.sidebar && ktAutoCode.modules.hasOptional && !ktAutoCode.module.code.visible",
          "group": "navigation@1"
        },
        {
          "command": "ktAutoCode.module.code.hide",
          "when": "view == ktAutoCode.sidebar && ktAutoCode.modules.hasOptional && ktAutoCode.module.code.visible",
          "group": "navigation@1"
        },
        {
          "command": "ktAutoCode.searchReplace.preview",
          "when": "view == ktAutoCode.sidebar",
          "group": "navigation@20"
        },
        {
          "command": "ktAutoCode.sidebar.toggleStyle",
          "when": "view == ktAutoCode.sidebar",
          "group": "navigation@22"
        },
        {
          "command": "ktAutoCode.worksets.open",
          "when": "view == ktAutoCode.sidebar",
          "group": "navigation@21"
        },
        {
          "command": "ktAutoCode.environment.open",
          "when": "view == ktAutoCode.sidebar",
          "group": "navigation@23"
        },
        {
          "command": "ktAutoCode.modulePanel.close",
          "when": "view == ktAutoCode.modulePanel",
          "group": "navigation@9"
        }
      ]
    },
    "configuration": {
      "title": "KT Auto Code",
      "properties": {
        "ktAutoCode.headerAscii.preserveGbk": {
          "type": "boolean",
          "default": false,
          "description": "头文件扫描/修复时保留 GBK 中文注释。默认关闭（纯 ASCII，推荐）。"
        },
        "ktAutoCode.headerAscii.stripBom": {
          "type": "boolean",
          "default": false,
          "description": "修复时去除 UTF-8 BOM (EF BB BF)，并将 UTF-16 等转为 UTF-8。未开启时宽字节文件不做字节级修复。"
        },
        "ktAutoCode.scope.includeHeaders": {
          "type": "boolean",
          "default": true,
          "description": "扫描范围：头文件 (.h / .hpp …)"
        },
        "ktAutoCode.scope.includeSource": {
          "type": "boolean",
          "default": true,
          "description": "扫描范围：源文件 (.cpp / .c …)"
        },
        "ktAutoCode.scope.includeMarkdown": {
          "type": "boolean",
          "default": true,
          "description": "扫描范围：.md / .mdx（仅「编码修正」工具）"
        },
        "ktAutoCode.sidebar.toolPickerStyle": {
          "type": "string",
          "enum": ["ribbon", "compact"],
          "enumDescriptions": ["大图标 Ribbon，可点击切换工具", "紧凑图标 Tab"],
          "default": "ribbon",
          "description": "Side Bar 顶部工具切换器样式。"
        },
        "ktAutoCode.sidebar.blockExpansionMode": {
          "type": "string",
          "enum": ["exclusive", "multiple"],
          "enumDescriptions": ["排他展开：除 Ribbon 外只展开最近使用的工具界面或结果", "允许多个工具/结果 Block 同时保持展开"],
          "default": "exclusive",
          "description": "控制 Ribbon 下方 Block 的展开方式。推荐排他展开以获得更大可用高度。"
        },
        "ktAutoCode.caa.externalEditor.command": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "CAA 外部编辑器命令或可执行文件路径。仅在用户点击 CATDlg 行的“打开外部编辑器”图标时启动。macOS 可配置 open，Windows 可配置编辑器 .exe。"
        },
        "ktAutoCode.caa.externalEditor.args": {
          "type": "array",
          "items": { "type": "string" },
          "default": ["${file}"],
          "scope": "resource",
          "description": "CAA 外部编辑器参数；仅允许普通参数及 ${file}、${workspace} 占位符。不会经 shell 执行。"
        },
        "ktAutoCode.caa.externalEditor.endpoint": {
          "type": "string",
          "default": "http://127.0.0.1:5180/api/caa/dialog/open",
          "scope": "resource",
          "description": "Desk Tools 本地 CAA 打开接口。未配置 command 时，点击外部编辑器会把 workspaceRoot 与 CATDlg 文件路径投递到此接口。"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "package": "vsce package --no-dependencies --baseContentUrl https://gitee.com/PhoenixWing321/kt-auto-code/blob/master/extension --baseImagesUrl https://gitee.com/PhoenixWing321/kt-auto-code/raw/master/extension"
  },
  "dependencies": {
    "@phoenix-wing/code-core": "0.4.0",
    "@phoenix-wing/kt-codegen": "0.4.0",
    "iconv-lite": "0.6.3"
  },
  "devDependencies": {
    "@types/vscode": "1.85.0",
    "esbuild": "^0.25.0",
    "@vscode/vsce": "^3.2.1",
    "typescript": "~5.7.2"
  }
}
