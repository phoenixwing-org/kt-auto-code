{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Code + CAD Extensions",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/extension",
        "--extensionDevelopmentPath=${workspaceFolder}/../kt-auto-cad"
      ],
      "outFiles": [
        "${workspaceFolder}/extension/dist/**/*.js",
        "${workspaceFolder}/../kt-auto-cad/dist/**/*.js"
      ],
      "preLaunchTask": "build extensions"
    },
    {
      "name": "Run Code Extension Only",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}/extension"],
      "outFiles": ["${workspaceFolder}/extension/dist/**/*.js"],
      "preLaunchTask": "build extension"
    },
    {
      "name": "Run Code Extension Only (样例 multiChar)",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/extension",
        "${workspaceFolder}/tests/fixtures/multiChar"
      ],
      "outFiles": ["${workspaceFolder}/extension/dist/**/*.js"],
      "preLaunchTask": "build extension"
    }
  ]
}
