{
  "name": "kt-auto-cad",
  "displayName": "KT Auto CAD",
  "description": "FCStd、BOM 与 CAD 引用工具；作为 KT Auto Code 的可选模块安装。",
  "author": "上海锟钛",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "publisher": "kuntai",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://gitee.com/PhoenixWing321/kt-auto-code.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "activationEvents": [
    "onCommand:ktAutoCad.open",
    "onCommand:ktAutoCad.module.show",
    "onCommand:ktAutoCad.module.hide",
    "onCommand:ktAutoCad.block.filename",
    "onCommand:ktAutoCad.block.scan",
    "onCommand:ktAutoCad.block.read",
    "onCommand:ktAutoCad.block.query",
    "onCommand:ktAutoCad.block.provider",
    "onCommand:ktAutoCad.block.diagnostics",
    "onCommand:ktAutoCad.diagnostics",
    "onCommand:ktAutoCad.readFcstdLight",
    "onCommand:ktAutoCad.readFcstd",
    "onCommand:ktAutoCad.queryWorkspaceDatabase",
    "onCommand:ktAutoCad.scanWorkspace",
    "onCommand:ktAutoCad.searchWorkspaceIndex",
    "onCommand:ktAutoCad.selectDeskToolsProvider"
  ],
  "extensionDependencies": [
    "kuntai.kt-auto-code"
  ],
  "main": "./dist/extension.js",
  "ktAutoCodeModule": {
    "id": "cad",
    "title": "CAD",
    "order": 20,
    "commandPrefix": "ktAutoCad.",
    "tools": [
      {
        "id": "cadFilename",
        "shortTitle": "文件名",
        "title": "CAD 文件名语义",
        "description": "使用 Wing CAD Core 分析当前 FCStd 文件名；无需 Desk Tools",
        "command": "ktAutoCad.block.filename",
        "icon": "shell:media/tools/cad-overview.svg",
        "requirement": "none"
      },
      {
        "id": "cadScan",
        "shortTitle": "检索",
        "title": "检索工作区 FCStd",
        "description": "使用 VS Code API 扫描并以 TypeScript 更新 SQLite 索引；无需 Desk Tools",
        "command": "ktAutoCad.block.scan",
        "icon": "shell:media/tools/cad-scan.svg",
        "requirement": "none"
      },
      {
        "id": "cadRead",
        "shortTitle": "读取",
        "title": "读取 FCStd 内容",
        "description": "TS 轻量读取直接可用；深度对象分析可选 Desk Tools provider",
        "command": "ktAutoCad.block.read",
        "icon": "shell:media/tools/cad-read.svg",
        "requirement": "optional-desk-provider"
      },
      {
        "id": "cadQuery",
        "shortTitle": "BOM引用",
        "title": "查询 BOM 与引用",
        "description": "查询 TS 索引生成的基础 BOM 与引用；无需 Desk Tools",
        "command": "ktAutoCad.block.query",
        "icon": "shell:media/tools/cad-query.svg",
        "requirement": "workspace-database"
      },
      {
        "id": "cadProvider",
        "shortTitle": "连接",
        "title": "Desk Tools Provider",
        "description": "按需选择并校验 Desk Tools native provider",
        "command": "ktAutoCad.block.provider",
        "icon": "shell:media/tools/cad-provider.svg",
        "requirement": "none"
      },
      {
        "id": "cadDiagnostics",
        "shortTitle": "诊断",
        "title": "CAD 能力诊断",
        "description": "查看可直接使用和需要 provider 的能力",
        "command": "ktAutoCad.block.diagnostics",
        "icon": "shell:media/tools/cad-diagnostics.svg",
        "requirement": "none"
      }
    ]
  },
  "contributes": {
    "commands": [
      {
        "command": "ktAutoCad.module.show",
        "title": "☐ CAD"
      },
      {
        "command": "ktAutoCad.module.hide",
        "title": "☑ CAD"
      },
      {
        "command": "ktAutoCad.open",
        "title": "KT Auto CAD：打开概览",
        "icon": "$(preview)"
      },
      {
        "command": "ktAutoCad.scanWorkspace",
        "title": "KT Auto CAD：扫描并索引工作区 FCStd",
        "icon": "$(files)"
      },
      {
        "command": "ktAutoCad.searchWorkspaceIndex",
        "title": "KT Auto CAD：搜索 SQLite 文件索引",
        "icon": "$(search)"
      },
      {
        "command": "ktAutoCad.readFcstdLight",
        "title": "KT Auto CAD：TS 轻量读取 FCStd",
        "icon": "$(file-zip)"
      },
      {
        "command": "ktAutoCad.readFcstd",
        "title": "KT Auto CAD：Desk 深度分析 FCStd",
        "icon": "$(file-binary)"
      },
      {
        "command": "ktAutoCad.queryWorkspaceDatabase",
        "title": "KT Auto CAD：查询 BOM 与引用",
        "icon": "$(database)"
      },
      {
        "command": "ktAutoCad.diagnostics",
        "title": "KT Auto CAD：诊断共享侧栏",
        "icon": "$(pulse)"
      },
      {
        "command": "ktAutoCad.selectDeskToolsProvider",
        "title": "KT Auto CAD：选择 Desk Tools Provider",
        "icon": "$(folder-opened)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "ktAutoCad.module.show",
          "when": "view == ktAutoCode.sidebar && ktAutoCode.module.cad.installed && !ktAutoCode.module.cad.visible",
          "group": "navigation@2"
        },
        {
          "command": "ktAutoCad.module.hide",
          "when": "view == ktAutoCode.sidebar && ktAutoCode.module.cad.installed && ktAutoCode.module.cad.visible",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "KT Auto CAD",
      "properties": {
        "ktAutoCad.deskToolsProviderManifest": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Desk Tools 安装资源中的 runtime/native-provider.json；可通过命令选择。"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@phoenix-wing/cad-core": "0.4.0",
    "@phoenix-wing/cad-contracts": "0.4.0",
    "@phoenix-wing/workspace-schema": "0.4.0",
    "@types/vscode": "1.85.0",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.25.0",
    "typescript": "~5.7.2"
  }
}
