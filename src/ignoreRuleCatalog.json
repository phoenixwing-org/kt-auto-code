    { "id": "project-my-cmake", "value": "my.cmake", "kind": "file", "categories": ["pnx-caa-study", "ktcore", "project-specific", "cmake", "user-local", "config"], "description": "KtCore 用户本地 CMake 配置" },
    { "id": "project-temp-markdown", "value": "temp.md", "kind": "file", "categories": ["pnx-caa-study", "ktcore", "project-specific", "user-local", "temporary"], "description": "KtCore 用户临时 Markdown 文档" },
