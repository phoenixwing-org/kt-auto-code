    { "id": "cpp-build", "value": "build/", "kind": "directory", "categories": ["cpp", "cmake", "build-output"], "description": "CMake 默认构建目录" },
    { "id": "cpp-build-debug", "value": "build_debug/", "kind": "directory", "categories": ["cpp", "cmake", "build-output", "debug"], "description": "CMake Debug 构建目录" },
    { "id": "cpp-build-release", "value": "build_release/", "kind": "directory", "categories": ["cpp", "cmake", "build-output", "release"], "description": "CMake Release 构建目录" },
