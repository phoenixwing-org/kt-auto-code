    { "id": "web-dist", "value": "dist/", "kind": "directory", "categories": ["web", "build-output"], "description": "Web 构建输出" },
    { "id": "web-next", "value": ".next/", "kind": "directory", "categories": ["web", "next", "build-output", "cache"], "description": "Next.js 构建与缓存" },
    { "id": "web-nuxt", "value": ".nuxt/", "kind": "directory", "categories": ["web", "nuxt", "build-output", "cache"], "description": "Nuxt 构建与缓存" },
    { "id": "web-vite", "value": ".vite/", "kind": "directory", "categories": ["web", "vite", "cache"], "description": "Vite 缓存" },
    { "id": "web-turbo", "value": ".turbo/", "kind": "directory", "categories": ["web", "turbo", "cache"], "description": "Turborepo 缓存" },
    { "id": "web-coverage", "value": "coverage/", "kind": "directory", "categories": ["web", "test", "build-output"], "description": "测试覆盖率输出" }
