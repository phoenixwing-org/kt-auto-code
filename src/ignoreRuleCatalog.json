    { "id": "tool-vscode", "value": ".vscode/", "kind": "directory", "categories": ["pnx-caa-study", "template-workspace", "project-specific", "vscode", "config", "review-required"], "description": "VS Code 工作区配置；可能包含共享任务和调试配置，默认不应忽略" },

