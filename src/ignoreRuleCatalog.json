{
  "version": 5,
  "rules": [
    { "id": "caa-tools-data", "value": "ToolsData/", "kind": "directory", "categories": ["caa", "scm", "tool-data", "user-local"], "description": "CAA V5 SCM 与开发工具工作数据目录" },
    { "id": "caa-objects", "value": "Objects/", "kind": "directory", "categories": ["caa", "mkmk", "build-intermediate", "generated"], "description": "mkmk 构建中间对象目录；按所在位置保存编译结果或框架 Identity Card 生成数据" },
    { "id": "caa-win-b64", "value": "win_b64/", "kind": "directory", "categories": ["caa", "windows", "x64", "mkmk-os", "build-output"], "description": "CAA V5 Windows 64 位平台输出目录（MkmkOS_VAR）" },
    { "id": "caa-install-config-win-b64", "value": "Install_config_win_b64/", "kind": "directory", "categories": ["caa", "windows", "x64", "install", "generated", "config"], "description": "CAA V5 Windows 64 位安装配置生成目录" },
    { "id": "caa-v5-level", "value": "CATIAV5Level.lvl", "kind": "file", "categories": ["caa", "version", "level", "generated"], "description": "CATIA V5 Level（版本级别）标识文件" },
    { "id": "caa-intel-a", "value": "intel_a/", "kind": "directory", "categories": ["caa", "windows", "x86", "mkmk-os", "build-output"], "description": "CAA V5 Windows 32 位平台输出目录（MkmkOS_VAR）" },
    { "id": "caa-catenv", "value": "CATEnv/", "kind": "directory", "categories": ["caa", "runtime-environment", "environment", "config"], "description": "CATIA/CAA V5 运行环境定义文件目录" },
    { "id": "caa-imported-interfaces", "value": "ImportedInterfaces/", "kind": "directory", "categories": ["caa", "mkmk", "interfaces", "interface-map", "generated"], "description": "mkmk 生成的外部接口映射与转接头文件目录" },
    { "id": "caa-various", "value": "various/", "kind": "directory", "categories": ["caa", "mkmk", "header-list", "build-intermediate", "generated"], "description": "mkmk 生成的接口头文件清单等构建辅助数据目录" },
    { "id": "caa-protected-generated", "value": "ProtectedGenerated/", "kind": "directory", "categories": ["caa", "mkmk", "protected", "interface-code", "tie", "generated"], "description": "mkmk 默认生成的 Protected 级接口代码目录，包括 TIE 头文件" },
    { "id": "caa-local-generated", "value": "LocalGenerated/", "kind": "directory", "categories": ["caa", "mkmk", "module-local", "generated-source", "generated"], "description": "mkmk 在模块内生成的本地源码或接口目录，包括语法处理结果" },
    { "id": "project-error-note", "value": "error.md", "kind": "file", "categories": ["pnx-caa-study", "project-specific", "user-local", "diagnostic"], "description": "PNXCaaStudy 用户本地错误记录" },
    { "id": "tool-obsidian", "value": ".obsidian/", "kind": "directory", "categories": ["pnx-caa-study", "project-specific", "obsidian", "user-local", "config"], "description": "Obsidian 工作区配置" },
    { "id": "tool-phoenix", "value": ".phoenix/", "kind": "directory", "categories": ["pnx-caa-study", "project-specific", "phoenix", "user-local", "config"], "description": "Phoenix Wing 工作区配置" },

    { "id": "system-ds-store", "value": ".DS_Store", "kind": "file", "categories": ["common", "macos", "os-metadata", "user-local"], "description": "macOS Finder 元数据文件" },
    { "id": "project-cache", "value": ".cache/", "kind": "directory", "categories": ["pnx-caa-study", "ktcore", "project-specific", "cache", "user-local"], "description": "KtCore 本地缓存目录" },
    { "id": "project-wasm", "value": "wasm/", "kind": "directory", "categories": ["pnx-caa-study", "ktcore", "project-specific", "webassembly", "build-output"], "description": "KtCore WebAssembly 构建输出目录" },
    { "id": "project-bigray", "value": "*.bigray", "kind": "pattern", "categories": ["pnx-caa-study", "ktcore", "project-specific", "generated"], "description": "KtCore 自定义 BigRay 生成文件" },
    { "id": "project-zip", "value": "*.zip", "kind": "pattern", "categories": ["pnx-caa-study", "ktcore", "project-specific", "archive", "review-required"], "description": "KtCore 本地 ZIP 归档；可能包含应提交资产，启用前需确认" },
    { "id": "project-ppm", "value": "*.ppm", "kind": "pattern", "categories": ["pnx-caa-study", "ktcore", "project-specific", "image-output", "review-required"], "description": "KtCore PPM 图像输出；启用前需确认是否为生成文件" },
    { "id": "project-history-obj", "value": "*.history.obj", "kind": "pattern", "categories": ["pnx-caa-study", "ktcore", "project-specific", "history", "generated"], "description": "KtCore 本地历史对象文件" },
