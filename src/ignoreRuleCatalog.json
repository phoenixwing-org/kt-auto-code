  "groups": [
    {
      "id": "caa-platform",
      "title": "CAA 平台输出",
      "description": "Windows 32/64 位平台输出、安装配置和 Level 标识",
      "ruleIds": ["caa-intel-a", "caa-win-b64", "caa-install-config-win-b64", "caa-v5-level"]
    },
    {
      "id": "caa-mkmk",
      "title": "CAA mkmk 中间目录",
      "description": "SCM 数据、环境、接口映射、头文件清单和构建对象",
      "ruleIds": ["caa-tools-data", "caa-objects", "caa-catenv", "caa-imported-interfaces", "caa-various"]
    },
    {
      "id": "caa-generated",
      "title": "CAA 生成接口",
      "description": "mkmk 生成的 Protected 与 Local 接口/源码",
      "ruleIds": ["caa-protected-generated", "caa-local-generated"]
    },
    {
      "id": "native-object",
      "title": "原生对象与预编译头",
      "description": "依赖、对象文件和预编译头",
      "ruleIds": ["native-dependency", "native-slo", "native-lo", "native-o", "cpp-object", "native-gch", "native-pch"]
    },
    {
      "id": "native-library",
      "title": "原生库与 Fortran 模块",
      "description": "动态库、静态库和 Fortran 模块产物",
      "ruleIds": ["native-so", "native-dylib", "native-dll", "fortran-mod", "fortran-smod", "native-lai", "native-la", "native-a", "native-lib"]
    },
    {
      "id": "native-executable",
      "title": "可执行与 Level 产物",
      "description": "各平台可执行文件和 CAA Level 生成文件",
      "ruleIds": ["native-exe", "native-out", "native-app", "caa-lvl"]
    },
    {
      "id": "cpp-cmake",
      "title": "C++ / CMake 构建目录",
      "description": "CMake、MSBuild 和 Visual Studio 本地构建输出",
      "ruleIds": ["cpp-build", "cpp-build-debug", "cpp-build-release", "cpp-cmake-build", "cpp-debug", "cpp-release", "cpp-visual-studio", "cpp-pdb"]
    },
    {
      "id": "web-node",
      "title": "Web / Node 依赖",
      "description": "Node 依赖目录",
      "ruleIds": ["web-node-modules"]
    },
    {
      "id": "web-output",
      "title": "Web 构建与缓存",
      "description": "Web 框架构建输出、缓存和覆盖率",
      "ruleIds": ["web-dist", "web-next", "web-nuxt", "web-vite", "web-turbo", "web-coverage"]
    },
    {
      "id": "local-tools",
      "title": "本地工具配置",
      "description": "操作系统和本地工具产生的配置",
      "ruleIds": ["system-ds-store", "tool-obsidian", "tool-phoenix"]
    },
    {
      "id": "pnx-project",
      "title": "PNXCaaStudy 项目特有",
      "description": "KtCore 和 PNXCaaStudy 的本地生成物",
      "includeCategories": ["pnx-caa-study"],
      "excludeCategories": ["review-required"]
    },
    {
      "id": "review-required",
      "title": "需确认规则",
      "description": "可能命中源码或应提交资产，必须逐条确认",
      "includeCategories": ["review-required"],
      "reviewRequired": true
    }
  ]
}
