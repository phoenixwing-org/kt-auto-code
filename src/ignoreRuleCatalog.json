    { "id": "native-la", "value": "*.la", "kind": "pattern", "categories": ["caa", "cpp", "native-build", "static-library", "build-output"], "description": "Libtool 库文件" },
    { "id": "native-a", "value": "*.a", "kind": "pattern", "categories": ["caa", "cpp", "native-build", "static-library", "unix", "build-output"], "description": "Unix 静态库" },
    { "id": "native-lib", "value": "*.lib", "kind": "pattern", "categories": ["caa", "cpp", "native-build", "static-library", "windows", "build-output"], "description": "Windows 静态库或导入库" },
