{
  "name": "@phoenix/code-plugin",
  "author": "上海锟钛",
  "version": "0.4.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "scan-encoding": "tsx scripts/scan-source-encoding.ts",
    "fix-encoding": "tsx scripts/scan-source-encoding.ts --fix",
    "fix-headers": "tsx scripts/scan-source-encoding.ts --fix --headers --ascii",
    "scan-file-encoding": "tsx scripts/scan-file-encoding.ts",
    "convert-file-encoding": "tsx scripts/scan-file-encoding.ts --convert",
    "ext:build": "pnpm -C extension build",
    "ext:watch": "pnpm -C extension watch",
    "ext:launch": "node scripts/launch-extension-host.mjs",
    "ext:launch:code": "node scripts/launch-extension-host.mjs --code-only",
    "cad:build": "pnpm -C extensions/kt-auto-cad build",
    "cad:watch": "pnpm -C extensions/kt-auto-cad watch",
    "extensions:typecheck": "pnpm -r --filter kt-auto-code --filter kt-auto-cad run typecheck",
    "extensions:build": "pnpm -r --filter kt-auto-code --filter kt-auto-cad run build",
    "ext:package": "pnpm -C extension package",
    "cad:package": "pnpm -C extensions/kt-auto-cad package",
    "extensions:package": "pnpm extensions:typecheck && pnpm ext:package && pnpm cad:package && node scripts/verify-extension-artifacts.mjs",
    "extensions:verify-artifacts": "node scripts/verify-extension-artifacts.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.3",
    "typescript": "~5.7.2",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "@phoenix-wing/code-core": "0.3.0",
    "iconv-lite": "0.6.3"
  },
  "pnpm": {
    "overrides": {
      "@phoenix-wing/code-core@0.3.0": "link:../phoenix-wing/packages/code-core",
      "@phoenix-wing/cad-core@0.3.0": "link:../phoenix-wing/packages/cad-core",
      "@phoenix-wing/cad-contracts@0.3.0": "link:../phoenix-wing/packages/cad-contracts",
      "@phoenix-wing/workspace-schema@0.3.0": "link:../phoenix-wing/packages/workspace-schema"
    }
  }
}
